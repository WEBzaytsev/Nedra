# Optional config for docker-compose.prod.yml. Copy to ".env" next to it and edit.
#   cp .env.prod.example .env
# Without a .env, Nedra runs on http://localhost:3000 with the latest release.

# Image version
# "latest", or pin to a release like 2.0.0 (no leading "v") for reproducible deploys.
NEDRA_VERSION=latest

# URL the BROWSER uses to reach the API (your host + backend port + /api):
NEDRA_API_URL=http://localhost:8000/api

# Origin the BROWSER loads the UI from (your host + frontend port):
NEDRA_FRONTEND_ORIGIN=http://localhost:3000

# Network exposure
# The UI and API are published on 127.0.0.1 only, so nothing else on your network
# can reach them. Keep that if a reverse proxy on this same host serves Nedra
# over HTTPS. To reach it directly from other machines (LAN, VPN, Tailscale),
# publish on every interface instead, and put HTTPS in front of it:
# NEDRA_BIND_ADDRESS=0.0.0.0

# Optional
# NEDRA_FRONTEND_PORT=3000
# NEDRA_BACKEND_PORT=8000

# Security keys bind to one exact browser host. For https://vault.example, set
# WEBAUTHN_RP_IDS=["vault.example"] before enrolling a key, then restart backend.
# Do not use a wildcard or copy a Host header value here.
# WEBAUTHN_RP_IDS=["vault.example"]

# Overrides every rate limit (unlock is 30/hour by default). Each CLI command
# unlocks once, so raise this if a batch of them trips it.
# NEDRA_RATE_LIMIT=200/hour

# Vault defaults (milliseconds). A saved administrator settings form overrides
# this complete default set. Existing saved settings are never rewritten on startup.
# NEDRA_INACTIVITY_MS=900000
# NEDRA_HIDDEN_MS=600000
# NEDRA_WARN_BEFORE_MS=60000
# NEDRA_DEBOUNCE_MS=1000
# NEDRA_CLIPBOARD_CLEAR_MS=30000
# NEDRA_UPDATE_CHECK_ENABLED=true
# To return an existing vault to environment defaults, stop the backend and use
# nedra-admin reset-settings --yes (keeps a checked rollback snapshot).

# Updates
# The app tells you when a release is out and shows the commands: take a
# snapshot of the vault, pull, restart. Snapshots and restores: docs/UPDATING.md.
