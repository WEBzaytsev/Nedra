#!/bin/sh
set -eu

RED='\033[31m'
NC='\033[0m'

die() {
  printf '%b\n' "${RED}✗ $*${NC}" >&2
  exit 1
}

target="$0"
while [ -L "$target" ]; do
  link="$(readlink "$target")"
  case "$link" in
    /*) target="$link" ;;
    *) target="$(dirname "$target")/$link" ;;
  esac
done
here="$(cd "$(dirname "$target")" && pwd)"

compose="${NEDRA_COMPOSE_FILE:-$here/docker-compose.prod.yml}"

[ -f "$compose" ] ||
  die "No compose file at $compose. Run this from your Nedra folder, or set NEDRA_COMPOSE_FILE."

command -v docker >/dev/null 2>&1 ||
  die "Docker isn't installed or isn't on your PATH."

if ! docker compose -f "$compose" ps --status running --services 2>/dev/null |
  grep -qx backend; then
  die "Nedra isn't running. Start it with:
    docker compose -f $compose up -d"
fi

exec docker compose -f "$compose" exec backend nedra "$@"
